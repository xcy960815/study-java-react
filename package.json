{
  "name": "study-java-react",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode daily",
    "dev:pre": "vite --mode pre",
    "dev:prod": "vite --mode prod",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build --mode daily",
    "build:pre": "tsc -b && vite build --mode pre",
    "build:prod": "tsc -b && vite build --mode prod",
    "preview": "dotenv -e env/.env.daily cross-env vite preview --base $VITE_BASE_URL",
    "preview:pre": "dotenv -e env/.env.pre cross-env vite preview --base $VITE_BASE_URL",
    "preview:prod": "dotenv -e env/.env.prod cross-env vite preview --base $VITE_BASE_URL",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "check": "pnpm lint:ci && pnpm build:prod",
    "prepare": "husky",
    "format": "pretty-quick --staged",
    "commit": "git-cz"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@icon-park/react": "^1.4.2",
    "@stomp/stompjs": "^7.3.0",
    "antd": "^6.3.1",
    "axios": "^1.13.5",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "lodash": "^4.17.23",
    "md5": "^2.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "sockjs-client": "^1.6.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/lodash": "^4.17.24",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cz-customizable": "^7.4.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}
